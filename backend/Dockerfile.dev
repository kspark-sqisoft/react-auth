# 개발용: 소스는 compose 볼륨 마운트, 컨테이너는 의존성+엔트리포인트만 준비
# Node.js 22 Alpine 베이스 이미지
FROM node:22-alpine
# 작업 디렉터리
WORKDIR /app
# 백엔드 헬스체크(wget) 및 기타 스크립트용
RUN apk add --no-cache wget
# 개발 엔트리포인트 스크립트를 이미지에 포함
COPY docker-dev-entrypoint.sh /usr/local/bin/docker-dev-entrypoint.sh
# Windows CRLF 제거 후 실행 권한 부여(한 줄 RUN으로 원자적 적용)
RUN tr -d '\r' < /usr/local/bin/docker-dev-entrypoint.sh > /tmp/docker-dev-entrypoint.sh \
  && mv /tmp/docker-dev-entrypoint.sh /usr/local/bin/docker-dev-entrypoint.sh \
  && chmod +x /usr/local/bin/docker-dev-entrypoint.sh
# 호스트 마운트 전에 이미지에서 npm ci 할 수 있도록 lock 파일 복사
COPY package.json package-lock.json ./
# 개발·빌드 도구 포함 전체 의존성 설치
RUN npm ci
# Vite/Nest dev 서버 포트
EXPOSE 3000
# 엔트리포인트에서 npm run start:dev 등 watch 모드 기동
ENTRYPOINT ["/usr/local/bin/docker-dev-entrypoint.sh"]
