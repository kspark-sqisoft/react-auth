# =============================================================================
# 백엔드 환경 변수 안내
# -----------------------------------------------------------------------------
# 1) 이 파일을 프로젝트 루트(backend 폴더)에서 `.env` 로 복사하세요.
#    PowerShell: Copy-Item .env.example .env
#    bash:       cp .env.example .env
# 2) 아래 항목 중 필요한 키만 `.env`에 두고, 값을 직접 입력하세요.
# 3) `.env`는 Git에 올리지 마세요. 여기에는 비밀키·실제 URL을 적지 않습니다.
# =============================================================================

# --- 서버 · 데이터 · 파일 저장 ---
# HTTP 포트. 비우면 코드 기본값(3000) 사용.
PORT=

# --- PostgreSQL (Docker compose 기본: reactauth / reactauth / reactauth) ---
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# 스키마 자동 동기화: true | false. 비우면 production이 아니면 true, production이면 false.
TYPEORM_SYNC=

# TypeORM 쿼리 로그. true일 때만 SQL 로그.
TYPEORM_LOGGING=

# 업로드 루트(절대 경로 또는 cwd 기준). 비우면 프로젝트의 uploads 폴더.
UPLOAD_ROOT=

# --- CORS · 프론트 연동 ---
# 브라우저에서 API를 호출할 프론트 오리진. 비우면 개발 편의상 CORS가 넓게 허용됩니다.
# 프로덕션에서는 반드시 실제 프론트 URL을 지정하는 것을 권장합니다.
# 여러 개면 쉼표로 구분 (예: https://app.example.com,http://localhost:5173)
FRONTEND_ORIGIN=

# --- JWT · 쿠키(리프레시) ---
# 액세스·리프레시 토큰 서명용 비밀 문자열. 프로덕션에서는 긴 랜덤 값으로 반드시 변경.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 토큰 만료 표현은 ms 패키지 형식(예: 15m, 7d). 비우면 코드 기본값.
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# 리프레시 토큰 HttpOnly 쿠키 이름. 비우면 기본 이름 사용.
REFRESH_TOKEN_COOKIE=

# 리프레시 쿠키 Max-Age(밀리초). JWT 리프레시 만료와 맞추는 것이 좋음. 비우면 코드 기본값.
REFRESH_COOKIE_MAX_AGE_MS=

# --- 북 AI · 미디어(선택) ---
# OpenAI API 키. 없으면 북 레이아웃 AI(/books/ai/layout) 등이 동작하지 않습니다.
OPENAI_API_KEY=

# 사용할 채팅 모델 이름. 비우면 코드에서 기본 모델을 사용합니다.
OPENAI_MODEL=

# Pexels API 키. 없으면 AI가 넣는 스톡 이미지·짧은 동영상 URL 보감이 스킵될 수 있습니다.
PEXELS_API_KEY=

# OpenWeatherMap API 키. 없으면 날씨 위젯용 API가 실패할 수 있습니다.
OPENWEATHERMAP_API_KEY=

# NewsAPI(https://newsapi.org/) 키. 없으면 북 뉴스 위젯용 API가 실패할 수 있습니다.
NEWSAPI_KEY=

# --- Node · 터미널(선택) ---
# production이면 쿠키 Secure 등이 달라집니다. 로컬 개발은 보통 비우거나 development.
NODE_ENV=

# 로그 색상(터미널). 필요 시 NO_COLOR=1 또는 FORCE_COLOR=0 등 표준 변수 참고.
# NO_COLOR=
# FORCE_COLOR=
